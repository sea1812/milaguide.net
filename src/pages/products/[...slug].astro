---
import { getCollection, render } from 'astro:content'; // 1. 引入 render

export async function getStaticPaths() {
  const productEntries = await getCollection('products');
  return productEntries.map(entry => ({
    // 在新版中，直接用 entry.id
    params: { slug: entry.id }, props: { entry },
  }));
}

const { entry } = Astro.props;
// 2. 新版渲染方式：使用 render(entry)
const { Content } = await render(entry);
---

<html lang="zh">
  <head><meta charset="UTF-8" />
<title>{entry.data.title}</title></head>
  <body style="font-family: sans-serif; max-width: 800px; margin: 40px auto; line-height: 1.6; padding: 0 20px;">
    <h1>{entry.data.title}</h1>
    <div style="background: #f4f4f4; padding: 20px; border-left: 4px solid #333; margin: 20px 0;">
      <strong>Mila 结论:</strong> {entry.data.verdict}
    </div>
    <article><Content /></article>
    <a href={entry.data.affiliate_link} style="display: inline-block; background: black; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px; margin-top: 20px;">
      前往 iHerb 查看
    </a>
  </body>
</html>
