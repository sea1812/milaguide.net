---
import Layout from '../layouts/Layout.astro';

const languages = [
  { code: 'en', name: 'English', flag: '🇺🇸' },
  { code: 'ja', name: '日本語', flag: '🇯🇵' },
  { code: 'ko', name: '한국어', flag: '🇰🇷' },
  { code: 'zh-hans', name: '简体中文', flag: '🇨🇳' },
  { code: 'zh-hant', name: '繁體中文', flag: '🇹🇼' }
];
---

<Layout title="MilaGuide" lang="en" showSidebar={false}>
  <div class="lang-selector-home">
    <div class="lang-grid-home">
      {languages.map(l => (
        <a href={`/${l.code}/`} class="lang-card-home">
          <span>{l.flag}</span>
          <span>{l.name}</span>
        </a>
      ))}
    </div>
  </div>

  <style>
    .lang-selector-home {
      padding: 1rem 0 2rem;
      border-bottom: 1px solid #e5e5e5;
      margin-bottom: 1.5rem;
    }
    .lang-grid-home {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .lang-card-home {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.75rem 1rem;
      border: 1px solid #e5e5e5;
      border-radius: 8px;
      font-size: 0.95rem;
      transition: all 0.2s;
    }
    .lang-card-home:hover {
      border-color: var(--color-accent);
      color: var(--color-accent);
      text-decoration: none;
    }
  </style>
</Layout>

<script is:inline>
  const userLang = navigator.language || navigator.userLanguage || 'en';
  const lang = userLang.toLowerCase().split('-')[0];
  const supportedLangs = ['en', 'ja', 'ko', 'zh-hans', 'zh-hant'];
  const targetLang = supportedLangs.includes(lang) ? lang : 'en';
  if (window.location.pathname === '/') {
    window.location.href = '/' + targetLang + '/';
  }
</script>