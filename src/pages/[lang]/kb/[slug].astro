---
import Layout from '../../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { getRelatedItems } from '../../../utils/tagSimilarity';

export async function getStaticPaths() {
  const languages = ['en', 'ja', 'ko', 'zh-hans', 'zh-hant'];
  const paths = [];

  for (const lang of languages) {
    const allItems = await getCollection('knowledge', ({ id }) => id.startsWith(`${lang}/`));

    for (const item of allItems) {
      const slug = item.id.replace(`${lang}/`, '').replace(/\.md$/, '');
      paths.push({
        params: { lang, slug },
        props: { item }
      });
    }
  }

  return paths;
}

const { lang, slug } = Astro.params;
const { item } = Astro.props;
const { Content } = await render(item);

const allItems = await getCollection('knowledge', ({ id }) => id.startsWith(`${lang}/`));
const relatedItems = getRelatedItems(item, allItems, 10);

const backLabels: Record<string, string> = {
  en: '← Back',
  ja: '← 返回',
  ko: '← 뒤로',
  'zh-hans': '← 返回',
  'zh-hant': '← 返回'
};

const relatedLabels: Record<string, { title: string; empty: string }> = {
  en: { title: 'Related', empty: 'No related items found' },
  ja: { title: '関連', empty: '関連する項目はありません' },
  ko: { title: '관련', empty: '관련 항목이 없습니다' },
  'zh-hans': { title: '相关', empty: '暂无相关项目' },
  'zh-hant': { title: '相關', empty: '暫無相關項目' }
};

const featuredLabels: Record<string, string> = {
  en: 'Featured',
  ja: '注目',
  ko: '추천',
  'zh-hans': '精选',
  'zh-hant': '精選'
};

const iherbLabels: Record<string, string> = {
  en: 'Visit',
  ja: '訪問',
  ko: '방문',
  'zh-hans': '访问',
  'zh-hant': '訪問'
};

const linkLabels: Record<string, string> = {
  en: 'Link',
  ja: 'リンク',
  ko: '링크',
  'zh-hans': '链接',
  'zh-hant': '鏈接'
};

function getItemUrl(item: any, lang: string) {
  return `/${lang}/kb/${item.id.replace(`${lang}/`, '').replace(/\.md$/, '')}`;
}
---

<Layout title={item.data.title} lang={lang}>
  <a href="#" onclick="window.history.back(); return false;" class="back-link">{backLabels[lang]}</a>

  <article>
    <h1>
      {item.data.title}
      {item.data.featured && <span class="featured-badge">{featuredLabels[lang]}</span>}
    </h1>
    <div class="meta">
      <time>{item.data.publishedAt.toLocaleDateString()}</time>
    </div>
    <div class="tags">
      {item.data.tags.map(tag => (
        <a href={`/${lang}/tags/${tag}`} class="tag">{tag}</a>
      ))}
    </div>
    <div class="content-body">
      <Content />
    </div>
    {item.data.type === 'product' && item.data.iherbLink && (
      <div class="external-link">
        <a href={item.data.iherbLink} target="_blank" rel="noopener noreferrer">{iherbLabels[lang]}: {item.data.iherbLink}</a>
      </div>
    )}
    {item.data.type === 'article' && item.data.link && (
      <div class="external-link">
        <a href={item.data.link} target="_blank" rel="noopener noreferrer">{linkLabels[lang]}: {item.data.link}</a>
      </div>
    )}
  </article>

  {relatedItems.length > 0 && (
    <section class="related-section">
      <h2>{relatedLabels[lang].title}</h2>
      <div class="related-list">
        {relatedItems.map(ri => (
          <a href={getItemUrl(ri, lang)} class="related-item">
            <span class="related-title">{ri.data.title}</span>
            <span class="related-tags">
              {ri.data.tags.slice(0, 3).join(', ')}
            </span>
          </a>
        ))}
      </div>
    </section>
  )}
</Layout>