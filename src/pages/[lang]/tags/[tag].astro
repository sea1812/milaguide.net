---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const languages = ['en', 'ja', 'ko', 'zh-hans', 'zh-hant'];
  const paths = [];

  for (const lang of languages) {
    const products = await getCollection('products', ({ id }) => id.startsWith(`${lang}/`));
    const articles = await getCollection('articles', ({ id }) => id.startsWith(`${lang}/`));
    const allTags = [...new Set([...products, ...articles].flatMap(item => item.data.tags))];

    for (const tag of allTags) {
      paths.push({
        params: { lang, tag },
        props: { tag, products, articles }
      });
    }
  }

  return paths;
}

const { lang, tag } = Astro.params;
const { products, articles } = Astro.props;

const filteredProducts = products.filter(p => p.data.tags.includes(tag));
const filteredArticles = articles.filter(a => a.data.tags.includes(tag));
const allContent = [...filteredProducts, ...filteredArticles].sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return b.data.publishedAt.getTime() - a.data.publishedAt.getTime();
});

const featuredLabels: Record<string, string> = {
  en: 'Featured',
  ja: '注目',
  ko: '추천',
  'zh-hans': '精选',
  'zh-hant': '精選'
};

const tagLabels: Record<string, string> = {
  en: 'Tag',
  ja: 'タグ',
  ko: '태그',
  'zh-hans': '标签',
  'zh-hant': '標籤'
};
---

<Layout title={`${tagLabels[lang]}: ${tag}`} lang={lang}>
  <h1 class="page-title-hidden">{tagLabels[lang]}: {tag}</h1>

  <div class="card-list">
    {allContent.map(item => (
      <article class="card">
        <h2>
          <a href={`/${lang}/${item.collection === 'products' ? 'p' : 'a'}/${item.id.replace(`${lang}/`, '').replace(/\.md$/, '')}`}>{item.data.title}</a>
          {item.data.featured && <span class="featured-badge">{featuredLabels[lang]}</span>}
        </h2>
        <div class="meta">
          <time>{item.data.publishedAt.toLocaleDateString()}</time>
        </div>
        <p>{item.data.description}</p>
        <div class="tags">
          {item.data.tags.map(t => (
            <a href={`/${lang}/tags/${t}`} class="tag">{t}</a>
          ))}
        </div>
      </article>
    ))}
  </div>
</Layout>