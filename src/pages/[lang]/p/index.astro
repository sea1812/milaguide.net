---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const languages = ['en', 'ja', 'ko', 'zh'];
  const paths = [];
  
  for (const lang of languages) {
    const products = await getCollection('products', ({ id }) => id.startsWith(`${lang}/`));
    const allTags = [...new Set(products.flatMap(p => p.data.tags))];
    
    paths.push({ 
      params: { lang }, 
      props: { products, allTags } 
    });
  }
  
  return paths;
}

const { lang } = Astro.params;
const { products, allTags } = Astro.props;

const sortedProducts = products.sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return b.data.publishedAt.getTime() - a.data.publishedAt.getTime();
});

const labels: Record<string, { list: string; products: string; articles: string }> = {
  en: { list: 'Products', products: 'Products', articles: 'Articles' },
  ja: { list: '製品', products: '製品', articles: '記事' },
  ko: { list: '제품', products: '제품', articles: '기사' },
  zh: { list: '产品', products: '产品', articles: '文章' }
};

const featuredLabels: Record<string, string> = {
  en: 'Featured',
  ja: '注目',
  ko: '추천',
  zh: '精选'
};
---

<Layout title={labels[lang].list} lang={lang}>
  <h1>{labels[lang].list}</h1>
  
  <div class="card-list">
    {sortedProducts.map(product => (
      <article class="card">
        <h2>
          <a href={`/${lang}/p/${product.id.replace(`${lang}/`, '').replace(/\.md$/, '')}`}>{product.data.title}</a>
          {product.data.featured && <span class="featured-badge">{featuredLabels[lang]}</span>}
        </h2>
        <div class="meta">
          <time>{product.data.publishedAt.toLocaleDateString()}</time>
        </div>
        <p>{product.data.description}</p>
        <div class="tags">
          {product.data.tags.map(tag => (
            <a href={`/${lang}/tags/${tag}`} class="tag">{tag}</a>
          ))}
        </div>
      </article>
    ))}
  </div>
</Layout>
