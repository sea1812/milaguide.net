---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'ja' } },
    { params: { lang: 'ko' } },
    { params: { lang: 'zh-hans' } },
    { params: { lang: 'zh-hant' } }
  ];
}

const { lang } = Astro.params;

const products = await getCollection('products', ({ id }) => id.startsWith(`${lang}/`));
const articles = await getCollection('articles', ({ id }) => id.startsWith(`${lang}/`));

const sortedItems = [...products, ...articles].sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return b.data.publishedAt.getTime() - a.data.publishedAt.getTime();
});

const labels: Record<string, string> = {
  en: 'AI Tools Problems & Fixes',
  ja: 'AIツールの問題と修正',
  ko: 'AI 도구 문제 및 수정',
  'zh-hans': 'AI工具问题与修复',
  'zh-hant': 'AI工具問題與修復'
};

const featuredLabels: Record<string, string> = {
  en: 'Featured',
  ja: '注目',
  ko: '추천',
  'zh-hans': '精选',
  'zh-hant': '精選'
};
---

<Layout title={labels[lang]} lang={lang} showSidebar={true}>
  <h1>{labels[lang]}</h1>

  <div class="card-list">
    {sortedItems.map(item => (
      <article class="card">
        <h2>
          <a href={`/${lang}/${item.collection === 'products' ? 'p' : 'a'}/${item.id.replace(`${lang}/`, '').replace(/\.md$/, '')}`}>{item.data.title}</a>
          {item.data.featured && <span class="featured-badge">{featuredLabels[lang]}</span>}
        </h2>
        <div class="meta">
          <time>{item.data.publishedAt.toLocaleDateString()}</time>
        </div>
        <p>{item.data.description}</p>
        <div class="tags">
          {item.data.tags.map(tag => (
            <a href={`/${lang}/tags/${tag}`} class="tag">{tag}</a>
          ))}
        </div>
      </article>
    ))}
  </div>
</Layout>